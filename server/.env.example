# Telegram bot tokeni (BotFather'dan olinadi)
BOT_TOKEN=
# Admin chat ID'si (yangi buyurtmalar shu chatga keladi; @userinfobot orqali bilib oling)
ADMIN_CHAT_ID=
# JWT imzolash uchun maxfiy kalit (uzun tasodifiy satr yozing)
JWT_SECRET=ozgartiring-uzun-tasodifiy-kalit
# Mini App ochiladigan URL (Netlify domeni, https bo'lishi shart)
WEB_APP_URL=
# Backendning ommaviy URL'i (rasm havolalari uchun)
BASE_URL=
# Mahsulot rasmlari yuklanadigan papka (Railway volume: /data/uploads)
UPLOAD_DIR=./uploads
# SQLite fayl yo'li (Railway volume: /data/shokoladchi.db)
DB_PATH=./data.db
# Server porti
PORT=3000
# Birinchi seed admin login/paroli
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# 1 qilinsa, Telegram'dan tashqarida (oddiy brauzerda) test kirish ishlaydi. Produksiyada 0!
DEV_AUTH=0
